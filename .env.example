APP_NAME=talksatconfs.com.test
APP_ENV=production
APP_KEY=base64:fyhneardFGbJ79NMJ/+gW4P7bmfsDDxjdYrxtojXiAA=
APP_DEBUG=false
APP_URL=https://talksatconfs.com.test

SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=prod
SCOUT_QUEUE=false

MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=''

LOG_CHANNEL=stack
LOG_LEVEL=warning

# talksatconfs
DB_TAC_DB_DRIVER="mysql"
DB_TAC_CONNECTION="talksatconfs"
DB_TAC_DATABASE="codeat3_co_talksatconfs"
# codeat3
DB_DRIVER="mysql"
DB_CONNECTION="primary"
DB_DATABASE="codeat3_co"
# default configuration
DB_HOST='localhost'
DB_PORT=3306
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE="codeat3_co"
DB_USERNAME='root'
DB_PASSWORD=""

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_DRIVER=redis

# Mail. Email verification is required for favourites and ratings, so
# production needs working mail. Several free-tier providers can be chained:
# set MAIL_MAILER=failover and fill in the credentials of every provider you
# signed up for (SMTP username/password). The first provider in
# MAIL_FAILOVER_ORDER is used until a send fails (e.g. its free quota is used
# up), then the next one takes over. MAIL_FROM_ADDRESS must be on a domain
# verified (SPF/DKIM) at every provider. Providers: brevo, mailgun, resend,
# mailjet, smtp2go. Optional MAIL_<NAME>_HOST / _PORT override (e.g. EU region).
MAIL_MAILER=failover
MAIL_FAILOVER_ORDER=brevo,mailgun,resend,mailjet,smtp2go
MAIL_FAILOVER_RETRY_AFTER=60
MAIL_FROM_ADDRESS="noreply@talksatconfs.com"
MAIL_FROM_NAME="Talks at Confs"
MAIL_BREVO_USERNAME=
MAIL_BREVO_PASSWORD=
MAIL_MAILGUN_USERNAME=
MAIL_MAILGUN_PASSWORD=
MAIL_RESEND_USERNAME=resend
MAIL_RESEND_PASSWORD=
MAIL_MAILJET_USERNAME=
MAIL_MAILJET_PASSWORD=
MAIL_SMTP2GO_USERNAME=
MAIL_SMTP2GO_PASSWORD=

# Tier 2 monitoring: shared Pulse database on monitor.codeat3.co's MySQL
# server. Same host/user across every participating app; only
# PULSE_SERVER_NAME differs per app. PULSE_ADMIN_EMAILS gates who can view
# the /pulse dashboard on this app (comma-separated list).
PULSE_DB_CONNECTION=pulse_central
PULSE_DB_HOST=127.0.0.1
PULSE_DB_PORT=3306
PULSE_DB_DATABASE=pulse_central
PULSE_DB_USERNAME=pulse_writer
PULSE_DB_PASSWORD=
PULSE_SERVER_NAME=talksatconfs.com
PULSE_ADMIN_EMAILS=swapnilsarwe@gmail.com
